# ============================================================
# MultiBot — Variables de entorno
# Copia este archivo como `.env` y completa los valores.
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)
# ============================================================

# --- Aplicación ---
APP_NAME=MultiBot
APP_ENV=development
LOG_LEVEL=INFO

# --- Meta WhatsApp Cloud API ---
# Token de verificación del webhook. Debe ser EXACTAMENTE el mismo valor que
# registres en Meta Developers -> App -> WhatsApp -> Configuration -> Webhook
# -> "Verify token".
WHATSAPP_VERIFY_TOKEN=mi_token_de_verificacion_secreto

# Token permanente del sistema (System User Token). Se usa desde la Fase 5.
WHATSAPP_ACCESS_TOKEN=

# ID del número de WhatsApp Business (ej. 123456789012345). Se usa en Fase 5.
WHATSAPP_PHONE_NUMBER_ID=

# Versión de la Graph API de Meta.
WHATSAPP_API_VERSION=v21.0

# --- OpenAI (Fase 3) ---
# Clave de API de OpenAI: https://platform.openai.com/api-keys
# Se usa para generar los embeddings y las respuestas del RAG.
OPENAI_API_KEY=

# Modelo de chat (rápido y económico) y modelo de embeddings.
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Temperatura del LLM: 0.0 = respuestas deterministas (cero alucinaciones).
RAG_TEMPERATURE=0.0

# --- Base de conocimiento (RAG) ---
# Carpeta donde se colocan los PDFs (condicionados, directorios, FAQs).
KNOWLEDGE_DIR=knowledge
# Carpeta de persistencia de ChromaDB (vectores).
CHROMA_PERSIST_DIR=data/chroma
# Nombre de la colección vectorial.
CHROMA_COLLECTION=multibot_kb
# Fragmentos recuperados por consulta y relevancia mínima para responder.
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.3

# --- Sesión y conversación (Fase 4) ---
# "memory" (desarrollo, sin Redis) | "redis" (producción, con Docker).
SESSION_STORE=memory
REDIS_URL=redis://localhost:6379/0
# TTL de la sesión por cliente: 24 horas.
SESSION_TTL_SECONDS=86400
# Número del asesor (ej. 573001234567) que recibe los leads por WhatsApp.
# Vacío = solo se notifica por consola.
ADVISOR_NOTIFY_WHATSAPP=

# --- Multi-tenant (Fase 7) ---
# Archivo JSON con el registro de agentes (ver tenants.example.json).
TENANTS_FILE=data/tenants.json

# --- Seguridad ---
# Clave del panel de administración (header X-Admin-Key). Genera una larga y
# aleatoria; nunca la subas a git. Ej.: openssl rand -hex 32
ADMIN_API_KEY=

# App Secret de Meta (App -> Settings -> Basic) para validar la FIRMA del
# webhook (X-Hub-Signature-256). OBLIGATORIO en producción.
WEBHOOK_APP_SECRET=

# --- Plataforma de atención (CRM / tickets) ---
# Base de datos relacional (SQLAlchemy): SQLite para arrancar, PostgreSQL en
# producción (p. ej. postgresql+asyncpg://user:pass@host/db).
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Backend de tickets: native (helpdesk propio, por defecto) | mock (demo)
CRM_PROVIDER=native
# Activar la sincronización webhook -> tickets del helpdesk propio.
CRM_ENABLED=false
